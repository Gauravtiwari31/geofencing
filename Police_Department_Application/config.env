# Police SEDI Environment Configuration

# Database Configuration (local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://sedi_user:sedi_password@localhost:2036/sedi_db
POSTGRES_USER=sedi_user
POSTGRES_PASSWORD=sedi_password
POSTGRES_DB=sedi_db

# MoD Core Configuration
MOD_CORE_ENABLED=true
MOD_CORE_URL=https://localhost:2025
MOD_CORE_STREAM_PATH=/v1/police/stream
MOD_CORE_ACK_PATH=/v1/police/ack
MOD_CORE_HEALTH_PATH=/health
MOD_CORE_RETRY_DELAY_SECONDS=5
MOD_CORE_RETRY_BACKOFF_MULTIPLIER=2.0
MOD_CORE_RETRY_MAX_DELAY_SECONDS=60
MOD_CORE_STREAM_TIMEOUT_SECONDS=65
MOD_CORE_ACK_TIMEOUT_SECONDS=10
MOD_CLIENT_CERT_PATH=/workspace/certs/sedi.crt
MOD_CLIENT_KEY_PATH=/workspace/certs/sedi.key
MOD_CA_CERT_PATH=/workspace/certs/ca.crt
# Optional static token for development
# MOD_CORE_STATIC_TOKEN=your-debug-token
MOD_CORE_TOKEN_URL=https://host.docker.internal:2027/realms/mod-core/protocol/openid-connect/token
MOD_CORE_CLIENT_ID=police-sedi
MOD_CORE_CLIENT_SECRET=police-sedi-secret-2025
MOD_CORE_TOKEN_SCOPE=email profile

# OIDC Configuration
OIDC_ISSUER_URL=https://keycloak.example.com/auth/realms/police
OIDC_CLIENT_ID=sedi-police-app
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=https://localhost:2035/auth/callback

# Application Configuration
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true
PORT=2035
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
